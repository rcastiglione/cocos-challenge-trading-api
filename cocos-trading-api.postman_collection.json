{
  "info": {
    "name": "Cocos Capital Trading Engine API",
    "description": "Postman Collection for the Cocos Challenge Transactional Trading Engine API (Portfolio Valuation with Money Pattern & Semantic Entity Grouping, Instrument Search, and Idempotent MARKET/LIMIT Order Routing).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get User Portfolio",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/portfolios/1",
          "host": ["{{baseUrl}}"],
          "path": ["portfolios", "1"]
        },
        "description": "Retrieves the user's portfolio with semantic grouping of user ({id, accountNumber}) and position instrument ({id, ticker}), alongside MonetaryAmount ({amount, currency: 'ARS'}) valuations."
      },
      "response": [
        {
          "name": "200 OK — Portfolio Valuation (Money Pattern & Semantic Entity Grouping)",
          "originalRequest": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/portfolios/1",
              "host": ["{{baseUrl}}"],
              "path": ["portfolios", "1"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "body": "{\n  \"user\": {\n    \"id\": 1,\n    \"accountNumber\": \"10001\"\n  },\n  \"totalAccountValue\": { \"amount\": 1697459.88, \"currency\": \"ARS\" },\n  \"availableCash\": { \"amount\": 1286738.70, \"currency\": \"ARS\" },\n  \"positions\": [\n    {\n      \"instrument\": {\n        \"id\": 47,\n        \"ticker\": \"PAMP\"\n      },\n      \"quantity\": 298,\n      \"lastPrice\": { \"amount\": 925.85, \"currency\": \"ARS\" },\n      \"marketValue\": { \"amount\": 275903.30, \"currency\": \"ARS\" },\n      \"totalReturnPercentage\": 2.15,\n      \"dailyReturnPercentage\": 1.55\n    }\n  ]\n}"
        }
      ]
    },
    {
      "name": "2. Search Instruments (General Query)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments?query=PAMP",
          "host": ["{{baseUrl}}"],
          "path": ["instruments"],
          "query": [
            {
              "key": "query",
              "value": "PAMP"
            }
          ]
        },
        "description": "Searches instruments matching ticker or name (case-insensitive substring match), returning lastPrice and previousClose as MonetaryAmount ({amount, currency: 'ARS'})."
      }
    },
    {
      "name": "3. Search Instruments (By Ticker & Name)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/instruments?ticker=MOLI&name=Molinos",
          "host": ["{{baseUrl}}"],
          "path": ["instruments"],
          "query": [
            {
              "key": "ticker",
              "value": "MOLI"
            },
            {
              "key": "name",
              "value": "Molinos"
            }
          ]
        }
      }
    },
    {
      "name": "4. Submit MARKET BUY Order (By Exact Share Quantity)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "description": "Mandatory UUID v4 idempotency key (24h TTL in Redis)"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 47,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Places a MARKET BUY order for an exact number of shares using the latest close price. Transitions immediately to FILLED (or REJECTED if insufficient funds) and returns price as MonetaryAmount."
      }
    },
    {
      "name": "5. Submit MARKET BUY Order (By Total ARS Investment Amount)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "description": "Mandatory UUID v4 idempotency key (24h TTL in Redis)"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 47,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"amount\": {\n    \"amount\": 15000.00,\n    \"currency\": \"ARS\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Places a MARKET BUY order by total ARS MonetaryAmount, automatically calculating the maximum whole shares (floor(amount / closePrice))."
      }
    },
    {
      "name": "6. Submit LIMIT BUY Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "description": "Mandatory UUID v4 idempotency key (24h TTL in Redis)"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 47,\n  \"side\": \"BUY\",\n  \"type\": \"LIMIT\",\n  \"size\": 5,\n  \"price\": {\n    \"amount\": 900.00,\n    \"currency\": \"ARS\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Places a LIMIT BUY order with a target MonetaryAmount price ({amount, currency: 'ARS'}). Stored in status NEW if funds are sufficient."
      }
    },
    {
      "name": "7. Cancel Pending (NEW) Order",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/105/cancel",
          "host": ["{{baseUrl}}"],
          "path": ["orders", "105", "cancel"]
        },
        "description": "Cancels an order currently in NEW status, transitioning it to CANCELLED."
      }
    },
    {
      "name": "8. Submit CASH_IN Transfer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "description": "Mandatory UUID v4 idempotency key (24h TTL in Redis)"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 66,\n  \"side\": \"CASH_IN\",\n  \"type\": \"MARKET\",\n  \"size\": 50000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Deposits ARS into the user's account using the MONEDA instrument."
      }
    },
    {
      "name": "9. Submit CASH_OUT Transfer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}",
            "description": "Mandatory UUID v4 idempotency key (24h TTL in Redis)"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 66,\n  \"side\": \"CASH_OUT\",\n  \"type\": \"MARKET\",\n  \"size\": 20000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Withdraws ARS from the user's account using the MONEDA instrument (validates that requested amount does not exceed availableCash)."
      }
    },
    {
      "name": "Fail: Duplicate Order (Idempotency test)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "123e4567-e89b-12d3-a456-426614174000",
            "description": "Hardcoded static UUID to test idempotency rejection (send twice to trigger 409 Conflict)"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"instrumentId\": 47,\n  \"side\": \"BUY\",\n  \"type\": \"MARKET\",\n  \"size\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": ["{{baseUrl}}"],
          "path": ["orders"]
        },
        "description": "Uses a static Idempotency-Key UUID (123e4567-e89b-12d3-a456-426614174000). Click 'Send' once to create the order (201 Created), then click 'Send' a second time to verify the 409 Conflict (Duplicate Order) idempotency protection."
      }
    }
  ]
}
